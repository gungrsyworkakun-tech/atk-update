# Menaikkan batas ukuran upload & POST agar foto (base64) tidak terpotong
php_value upload_max_filesize 20M
php_value post_max_size 25M
php_value max_execution_time 120
php_value memory_limit 256M

# ============================================================
# KEAMANAN: file & folder yang tidak boleh dibuka lewat browser
# ============================================================
<FilesMatch "(?i)(\.(sql|bak|log|md|sqlite|env|ini|sh|yml|yaml|dist)$|^error_log$|^config(\.example)?\.php$|^\.git)">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(.*/)?(data|logs|includes|_cadangan_[^/]+|\.git)(/|$) - [F,L]
</IfModule>

# ============================================================
# Clean URL: akses halaman tanpa akhiran .php
# Contoh: /penitipan  -> otomatis membuka penitipan.php
#         /penitipan.php tetap bisa diakses seperti biasa (tidak dihapus)
# ============================================================
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Kalau yang diminta memang file/folder asli (termasuk file .php langsung), biarkan apa adanya
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Kalau path tanpa ekstensi cocok dengan file .php yang ada, arahkan (internal) ke file itu
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^([^.]+)$ $1.php [L]
</IfModule>

# ============================================================
# Percepat muat halaman: simpan gambar & font di cache browser, kompres teks
# ============================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png  "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/ttf   "access plus 365 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/json
</IfModule>
